{
  "name": "aurora-project-title-dev",
  "version": "1.0.0",
  "description": "A new Plone project using Aurora with a Python CMFPlone backend.",
  "author": "Asko Soukka",
  "homepage": "https://github.com/collective/project-title",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "REGISTRYCONFIG=$(pwd)/registry.config.ts pnpm --filter @plone/aurora dev",
    "start": "REGISTRYCONFIG=$(pwd)/registry.config.ts pnpm --filter @plone/aurora dev",
    "start:prod": "pnpm --filter @plone/aurora start:prod",
    "build": "REGISTRYCONFIG=$(pwd)/registry.config.ts pnpm --filter @plone/aurora build",
    "build:deps": "pnpm --filter @plone/registry --filter @plone/components build",
    "i18n": "pnpm --filter aurora-project-title i18n && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto i18n",
    "test": "pnpm --filter aurora-project-title exec vitest --passWithNoTests",
    "lint": "REGISTRYCONFIG=$(pwd)/registry.config.ts eslint --max-warnings=0 'packages/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "REGISTRYCONFIG=$(pwd)/registry.config.ts eslint --fix 'packages/**/*.{js,jsx,ts,tsx}'",
    "prettier": "prettier --check 'packages/**/*.{js,jsx,ts,tsx}'",
    "prettier:fix": "prettier --write 'packages/**/*.{js,jsx,ts,tsx}' ",
    "stylelint": "stylelint 'packages/**/*.{css,scss,less}' --allow-empty-input",
    "stylelint:fix": "stylelint 'packages/**/*.{css,scss,less}' --fix --allow-empty-input",
    "dry-release": "pnpm --filter aurora-project-title dry-release",
    "release": "pnpm --filter aurora-project-title release",
    "release-major-alpha": "pnpm --filter aurora-project-title release-major-alpha",
    "release-alpha": "pnpm --filter aurora-project-title release-alpha",
    "storybook": "VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto storybook dev -p 6006 -c $(pwd)/.storybook",
    "storybook-build": "VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto build-storybook -c $(pwd)/.storybook",
    "test:acceptance": "playwright test",
    "test:acceptance:ui": "playwright test --ui"
  },
  "dependencies": {
    "@plone/registry": "workspace:*",
    "@plone/aurora": "workspace:*",
    "aurora-project-title": "workspace:*"
  },
  "devDependencies": {
    "mrs-developer": "^2.2.0"
  },
  "packageManager": "pnpm@11.20.0"
}
